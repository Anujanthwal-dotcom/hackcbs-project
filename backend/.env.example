# ==============================================================================
# KisaanBandhu Backend Environment Configuration (.env)
# ==============================================================================

# Database Connection (MongoDB Replica Set)
DATABASE_URL="mongodb://localhost:27017/kisaan_bandhu?replicaSet=rs0&directConnection=true"

# JWT Authentication
JWT_SECRET="kisaan_bandhu_jwt_super_secret_key_sih2026"
JWT_EXPIRATION="7d"

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API (Required for Online Mascot Intelligence Layer)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Meko Conversational Memory (Persistent Farmer Memory Across App Restarts)
# Obtain from: https://meko.ai (Create an Ambient Agent Datapack)
# Note: Memory space is strictly isolated from Crop Disease Agent records.
# ------------------------------------------------------------------------------
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_BASE_URL=https://api.meko.ai/v1

# ------------------------------------------------------------------------------
# 3. Vapi Voice & Outbound Calling (Future Agricultural Telephony Orchestration)
# Obtain from: https://vapi.ai
# NOTE: No live paid calls are triggered in current phase (Preview only).
# ------------------------------------------------------------------------------
VAPI_PRIVATE_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ------------------------------------------------------------------------------
# 4. Twilio Telephony (Optional/Alternative Telephony Provider)
# Obtain from: https://www.twilio.com/console
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

